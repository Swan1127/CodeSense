# ============================================
# CodeSense 酷森思 - 环境变量配置模板
# ============================================
# 
# 使用说明：
# 1. 复制此文件为 .env： cp env.example .env
# 2. 填写实际的配置值
# 3. .env 文件不会被提交到Git仓库（已在.gitignore中排除）
#

# ============================================
# Flask 基础配置
# ============================================

# 运行环境: development | testing | production
FLASK_CONFIG=development

# 应用密钥（生产环境必须设置为强密钥，至少32个字符）
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production-min-32-chars

# ============================================
# 数据库配置
# ============================================

# 生产环境数据库连接（生产环境必需）
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/student_code_review

# 开发环境数据库连接（可选，不设置则使用SQLite）
# DEV_DATABASE_URL=mysql+pymysql://root:password@localhost:3306/student_code_review

# 测试环境数据库连接（可选）
# TEST_DATABASE_URL=sqlite:///test_student_code_review.db

# ============================================
# AI API 配置
# ============================================

# 智谱AI API密钥（推荐）
# 获取地址: https://open.bigmodel.cn/
ZHIPU_API_KEY=your-zhipu-api-key-here

# OpenAI API密钥（可选，作为备选）
# 获取地址: https://platform.openai.com/
# OPENAI_API_KEY=your-openai-api-key-here

# ============================================
# 安全配置（生产环境）
# ============================================

# Cookie安全设置（生产环境启用HTTPS时设置为true）
SECURE_COOKIES=false

# ============================================
# 可选配置
# ============================================

# 日志级别: DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_LEVEL=INFO

# 服务器配置（生产环境）
# GUNICORN_WORKERS=4
# GUNICORN_TIMEOUT=120

# 上传文件大小限制（单位：MB）
# MAX_UPLOAD_SIZE=16

