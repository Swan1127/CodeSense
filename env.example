# ============================================
# CodeSense 酷森思 - 环境变量配置模板
# ============================================
# 
# 使用说明：
# 1. 复制此文件为 .env： cp env.example .env
# 2. 根据您的部署环境填写以下参数
# 3. .env 包含敏感数据，严禁推送到 Git 仓库
#

# ============================================
# 服务运行配置 (Server Binding)
# ============================================
# 运行环境: development | testing | production
FLASK_CONFIG=development

# 端口配置 (默认开发5000，生产建议8000+)
PORT=5000
# 绑定主机 (本地开发建议127.0.0.1，部署服务器必须设为0.0.0.0以允许外网访问)
HOST=127.0.0.1

# ============================================
# 数据库配置 (Database)
# ============================================
# 生产环境/主数据库连接 (必须)
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名
# 示例: DATABASE_URL=mysql+pymysql://codesense:supersecret@localhost:3306/student_code_review
# 注意: 如果未设置此项，开发环境将自动回退到 SQLite 数据库
DATABASE_URL=mysql+pymysql://root:root@localhost/student_code_review

# ============================================
# 安全配置 (Security)
# ============================================
# [必填] 应用程序安全密钥 (务必设置一个固定且强大的密钥，否则在云服务器多进程环境下会导致登录失效)
# 生成建议: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=dev-key-change-in-production

# [可选] HTTPS 安全 Cookie 设置
# 生产模式下默认开启 (True)。如果您在云服务器上通过 HTTP (非 HTTPS) 访问导致无法登录，请设置为 false
SECURE_COOKIES=false

# ============================================
# 大模型 API 配置 (AI APIs)
# ============================================
# 智谱AI API密钥 (主用，https://open.bigmodel.cn/)
ZHIPU_API_KEY=your-zhipu-api-key-here

# OpenAI API密钥 (备用，https://platform.openai.com/)
# OPENAI_API_KEY=your-openai-api-key-here

# ============================================
# 系统高级配置 (Advanced)
# ============================================
# 日志级别: DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_LEVEL=INFO

# 禁用或开启 Flask Debug 模式 (true/1 开启, false/0 关闭)
FLASK_DEBUG=1
