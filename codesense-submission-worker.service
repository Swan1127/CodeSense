[Unit]
Description=CodeSense submission evaluation RQ worker
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=codesense
Group=codesense
WorkingDirectory=/var/www/codesense
EnvironmentFile=-/var/www/codesense/.env
Environment="PATH=/opt/codesense/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment=CODESENSE_CONFIG=production
ExecStart=/opt/codesense/venv/bin/python -m tasks.submission_worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
